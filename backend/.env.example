LLM_BASE_URL=https://llm-dinftn7ztwksq2qd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=kimi-k3

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# fastembed (ONNX, default) | sentence-transformers (torch, needs requirements-torch.txt) | auto
EMBEDDING_BACKEND=fastembed
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_BASE_URL=https://api.cohere.com/v2/rerank
RERANK_ENABLED=false
# seconds between rerank calls when running the evaluation set (Cohere trial key: 10 calls / minute)
RERANK_EVAL_INTERVAL=6.5

CHROMA_DIR=storage/chroma
SQLITE_URL=sqlite:///storage/app.db
UPLOAD_DIR=storage/uploads

CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
RECALL_K=20
RRF_K=60
VECTOR_THRESHOLD=0.40
RERANK_THRESHOLD=0.2
HISTORY_ROUNDS=5
USE_HYBRID=true

CORS_ORIGINS=http://localhost:5173
